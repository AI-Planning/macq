(define (domain playlistmaker)
    (:requirements :equality :typing :negative-preconditions)
    (:types
        genre - object
        song - object
    )


    (:predicates
        (in_playlist ?x1 - song)
        (on ?x1 - song ?x2 - song)
        (has_genre ?x1 - song ?x2 - genre)
        (empty )
    )


    

    
    (:action add_song
     :parameters (?add - song ?prev - song ?genre1 - genre ?genre2 - genre)
     :precondition (and (not (in_playlist ?add)) (in_playlist ?prev) (has_genre ?add ?genre1) (has_genre ?prev ?genre2) (not (= ?genre1 ?genre2)))
     :effect (and
        (in_playlist ?add)
        (on ?prev ?add))
    )


    (:action add_first_song
     :parameters (?add - song)
     :precondition (empty )
     :effect (and
        (in_playlist ?add)
        (not (empty )))
    )


    (:action empty_test
     :parameters ()
     :precondition (empty )
     :effect (and
        (empty ))
    )

)